<script>
  // Nav scroll
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 60);
  });

  // Cursor
  const cursor = document.getElementById('cursor');
  let cx = 0, cy = 0, tx = 0, ty = 0;
  let cursorStarted = false;
  function cursorRaf() {
    cx += (tx - cx) * 0.18;
    cy += (ty - cy) * 0.18;
    if (cursor) {
      cursor.style.setProperty('--x', `${cx}px`);
      cursor.style.setProperty('--y', `${cy}px`);
    }
    requestAnimationFrame(cursorRaf);
  }
  window.addEventListener('mousemove', (e) => {
    tx = e.clientX;
    ty = e.clientY;
    cursor?.classList.add('on');
    if (!cursorStarted) {
      cursorStarted = true;
      requestAnimationFrame(cursorRaf);
    }
  }, { passive: true });

  const hoverTargets = document.querySelectorAll('a, button, .col-card, .look-item, .mosaic-tile, .g, .why-card');
  hoverTargets.forEach((el) => {
    el.addEventListener('mouseenter', () => cursor?.classList.add('active'));
    el.addEventListener('mouseleave', () => cursor?.classList.remove('active'));
  });
  const sofaHoverTargets = document.querySelectorAll('.sofa-item, .sofa-img');
  sofaHoverTargets.forEach((el) => {
    el.addEventListener('mouseenter', () => cursor?.classList.add('view-mode'));
    el.addEventListener('mouseleave', () => cursor?.classList.remove('view-mode'));
  });

  // Mobile menu
  const menuBtn = document.getElementById('menuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const menuClose = document.getElementById('menuClose');
  const mobileLinks = document.getElementById('mobileLinks');

  function openMenu() {
    mobileMenu.classList.add('open');
    mobileMenu.setAttribute('aria-hidden', 'false');
    menuBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    mobileMenu.classList.remove('open');
    mobileMenu.setAttribute('aria-hidden', 'true');
    menuBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);
  mobileMenu?.addEventListener('click', (e) => {
    if (e.target === mobileMenu) closeMenu();
  });
  mobileLinks?.addEventListener('click', (e) => {
    const a = e.target.closest('a');
    if (a) closeMenu();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu.classList.contains('open')) closeMenu();
  });

  // Slow + smooth anchor scrolling (premium easing)
  const prefersReduced = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
  function easeInOutCubic(t) {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }
  function getNavOffset() {
    const n = document.getElementById('navbar');
    if (!n) return 0;
    return Math.round(n.getBoundingClientRect().height) + 10;
  }
  function smoothScrollToY(targetY, durationMs = 600) {
    if (prefersReduced) {
      window.scrollTo(0, targetY);
      return;
    }
    const startY = window.scrollY || window.pageYOffset;
    const delta = targetY - startY;
    const start = performance.now();
    function tick(now) {
      const t = Math.min(1, (now - start) / durationMs);
      const eased = easeInOutCubic(t);
      window.scrollTo(0, Math.round(startY + delta * eased));
      if (t < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  document.addEventListener('click', (e) => {
    const a = e.target.closest?.('a[href^="#"]');
    if (!a) return;
    const href = a.getAttribute('href');
    if (!href || href === '#') return;
    const id = href.slice(1);
    const target = document.getElementById(id);
    if (!target) return;

    e.preventDefault();
    if (mobileMenu?.classList.contains('open')) closeMenu();
    const y = Math.max(0, target.getBoundingClientRect().top + window.scrollY - getNavOffset());
    smoothScrollToY(y, 800);
    history.pushState(null, '', href);
  }, { passive: false });

  // Hero product stage logic
  const sofaItems = document.querySelectorAll('[data-sofa-item]');
  const heroShowcase = document.getElementById('heroShowcase');
  let currentSofa = 0;
  let sofaTimer;
  const SOFA_FALL_MS = 3800;
  const SOFA_DROP_OUT_MS = 1700;
  const SOFA_GAP_MS = 500;
  const SOFA_HOLD_MS = 1400;

  function scheduleNextSofa(delayMs) {
    clearTimeout(sofaTimer);
    sofaTimer = setTimeout(runSofaCycle, delayMs);
  }

  function runSofaCycle() {
    if (!sofaItems.length) return;
    const outgoing = sofaItems[currentSofa];
    const nextIndex = (currentSofa + 1) % sofaItems.length;
    const incoming = sofaItems[nextIndex];

    outgoing.classList.remove('active');
    outgoing.classList.add('exit');
    incoming.classList.remove('exit', 'active');

    setTimeout(() => {
      incoming.classList.add('active');
      currentSofa = nextIndex;
    }, SOFA_DROP_OUT_MS + SOFA_GAP_MS);

    setTimeout(() => {
      outgoing.classList.remove('exit');
    }, SOFA_DROP_OUT_MS + SOFA_GAP_MS + SOFA_FALL_MS);

    scheduleNextSofa(SOFA_DROP_OUT_MS + SOFA_GAP_MS + SOFA_FALL_MS + SOFA_HOLD_MS);
  }
  
  // Start auto-rotation (pause when tab is hidden)
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      clearTimeout(sofaTimer);
    } else {
      scheduleNextSofa(SOFA_HOLD_MS);
    }
  });

  // Trigger initial animation for first sofa
  window.addEventListener('load', () => {
    sofaItems[0]?.classList.add('active');
    scheduleNextSofa(SOFA_FALL_MS + SOFA_HOLD_MS);
  });

  // Hero motion on scroll
  const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
  if (!prefersReducedMotion && heroShowcase) {
    const brandText = heroShowcase.querySelector('.hero-brand-bg');

    window.addEventListener('scroll', () => {
      const y = Math.min(window.scrollY, 320);
      const progress = y / 320;
      if (brandText) {
        brandText.style.transform = `translate(-50%, ${(-62 + progress * 5)}%) scale(${1 - progress * 0.04})`;
      }
      heroShowcase.classList.toggle('scrolled', window.scrollY > 36);
    }, { passive: true });
  }

  // ── LOOKBOOK ACCORDION ──
  (function () {
    const accordion = document.getElementById('lookAccordion');
    if (!accordion) return;
    const panels = Array.from(accordion.querySelectorAll('.look-panel'));

    function activatePanel(index) {
      panels.forEach((p, i) => {
        p.classList.toggle('active', i === index);
      });
      // Mobile: update heights
      if (window.innerWidth < 840) {
        panels.forEach((p) => {
          p.style.height = p.classList.contains('active') ? '460px' : '68px';
        });
      }
    }

    const isTouch = () => window.matchMedia('(hover: none) and (pointer: coarse)').matches;

    // Desktop: hover to expand
    panels.forEach((panel, i) => {
      panel.addEventListener('mouseenter', () => {
        if (!isTouch()) activatePanel(i);
      });
    });

    // Click / tap
    panels.forEach((panel, i) => {
      panel.addEventListener('click', () => activatePanel(i));
      panel.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activatePanel(i);
        }
      });
    });

    // Mobile: stack vertically
    function applyResponsive() {
      const isMobile = window.innerWidth < 840;
      accordion.style.flexDirection = isMobile ? 'column' : 'row';
      accordion.style.height = isMobile ? 'auto' : '';
      panels.forEach((p) => {
        if (isMobile) {
          p.style.flex = '0 0 auto';
          p.style.height = p.classList.contains('active') ? '460px' : '68px';
          p.style.transition = 'height 0.9s cubic-bezier(0.77, 0, 0.175, 1), filter 0.7s ease';
        } else {
          p.style.flex = '';
          p.style.height = '';
          p.style.transition = '';
        }
      });
    }
    applyResponsive();
    window.addEventListener('resize', applyResponsive, { passive: true });
  })();

  // Reveal on scroll
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });
  reveals.forEach(el => observer.observe(el));

  // Enquiry (demo) submit
  const enquiryForm = document.getElementById('enquiryForm');
  const formNote = document.getElementById('formNote');
  enquiryForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    formNote.style.display = 'block';
    const btn = enquiryForm.querySelector('button[type="submit"]');
    btn?.setAttribute('disabled', 'true');
    btn?.setAttribute('aria-disabled', 'true');
    setTimeout(() => {
      enquiryForm.reset();
      btn?.removeAttribute('disabled');
      btn?.removeAttribute('aria-disabled');
    }, 1200);
  });
</script>
